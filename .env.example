GEMINI_API_KEY=your-key-here

# Fast text mode (default) and Live mode models
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_LIVE_MODEL=gemini-3.8-live
# THINKING_LEVEL=MINIMAL        # MINIMAL | LOW | MEDIUM | HIGH, or "off" to not send it
# PORT=3000

# Optional: Vertex AI, where requests go to a region close to you. From Turkey, Milan (europe-west8) answers soonest;
# run `npm run probe:regions` to measure from your own computer. See docs/regions.md.
# Needs `gcloud auth application-default login` and a billing-enabled project.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=europe-west8

# Voice conversation (Gemini Live)
# GEMINI_VOICE=Kore             # prebuilt voice name; unset = the model's default
# MAX_VOICE_CALLS=5             # concurrent calls the server will accept

# Group conversation
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts    # speaks each line in its character's voice (the lite model starts fastest; gemini-3.8-flash-tts is fuller)
# GEMINI_CONDUCTOR_MODEL=gemini-3.5-flash-lite  # decides who speaks next (default: the text model)
# GROUP_MAX_TURNS=4        # lines per round before the floor goes back to the student
# GROUP_MAX_ROUNDS=6       # rounds running at once
# GROUP_MAX_SPEECH=8       # speech requests running at once
# GROUP_TTS_CONCURRENCY=3  # lines turned into speech at once (speech models allow few requests per minute)
# GROUP_FAST_START=true    # choose the first speaker of a round by rules, with no model call (false = always ask the model)
# GROUP_CONDUCTOR_TIMEOUT_MS=1500  # stop waiting for the conductor model after this long and use the rules
# GROUP_LOG_TIMING=1       # log how long each line and each voice takes to start
